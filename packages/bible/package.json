{
  "name": "@kitana-sdk/bible",
  "version": "0.1.0",
  "description": "Persistent context for agentic pipelines — resume after crashes, compress context on model failover.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ataztech910/kitana.git",
    "directory": "packages/bible"
  },
  "keywords": ["claude", "ai", "llm", "agent", "pipeline", "persistence"],
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc"
  },
  "dependencies": {
    "@kitana-sdk/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  }
