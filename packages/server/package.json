{
  "name": "@kitana-sdk/server",
  "version": "0.1.1",
  "description": "OpenAI-compatible HTTP server backed by your Claude subscription. No API keys.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "kitana-server": "dist/server.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ataztech910/kitana.git",
    "directory": "packages/server"
  },
  "keywords": ["claude", "claude-code", "ai", "llm", "openai-compatible", "n8n", "openclaw"],
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/server.ts",
    "prepublishOnly": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc"
  },
  "dependencies": {
    "@kitana-sdk/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "ts-node": "^10.9.0",
    "@types/node": "^20.0.0"
  }
}
