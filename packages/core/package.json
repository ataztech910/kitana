{
  "name": "@kitana-sdk/core",
  "version": "0.1.8",
  "description": "Router, provider detection, and failover for AI CLI subscriptions (Claude, Codex, Ollama) — no API keys required.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ataztech910/kitana.git",
    "directory": "packages/core"
  },
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "llm",
    "router",
    "failover",
    "ollama"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "openai": "^4.68.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  }
}
